# ── REQUIRED: Notion ──────────────────────────────────────────────────────────
# 1. Go to https://www.notion.so/my-integrations
# 2. Click "New integration", give it a name (e.g. "Job Copilot"), save
# 3. Copy the "Internal Integration Secret" below
NOTION_API_KEY=

# 4. Create a new Notion database (or use an existing one)
# 5. Open the database, click "..." → "Copy link to view"
#    The 32-character string after the last "/" (before any "?") is your database ID
# 6. Important: go to the database → "..." → "Add connections" → select your integration
NOTION_DATABASE_ID=

# ── OPTIONAL: Backend port ────────────────────────────────────────────────────
# Only change this if port 8000 is already in use on your machine
# BACKEND_PORT=8000
