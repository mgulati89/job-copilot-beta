{
  "manifest_version": 3,
  "name": "Fieldwork [Beta]",
  "version": "2.0.0",
  "description": "Beta build — Railway backend",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://job-copilot-beta-production.up.railway.app/*",
    "*://*.linkedin.com/*",
    "*://linkedin.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.workable.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.welcometothejungle.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://linkedin.com/jobs/*"
      ],
      "js": [
        "api-config.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.workable.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.welcometothejungle.com/*"
      ],
      "js": [
        "cross-board.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
